{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontier Loop Ticket Contract",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "public_outcome",
    "blocked_by",
    "risk_lane",
    "read_set",
    "write_set",
    "conflict_keys",
    "review_lenses",
    "verification",
    "budgets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "legacy_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "planned",
        "ready",
        "claimed",
        "in_progress",
        "review",
        "repair",
        "passed",
        "committed",
        "blocked",
        "superseded",
        "closed"
      ]
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "public_outcome": {
      "type": "string",
      "minLength": 1
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "risk_lane": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "preflight_required": {
      "type": "boolean"
    },
    "read_set": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_set": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit_policy": {
      "enum": [
        "coordinator",
        "isolated-worker"
      ]
    },
    "review_lenses": {
      "type": "array",
      "items": {
        "enum": [
          "combined",
          "spec-authority",
          "code-test",
          "operations-security"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "required": [
        "repair_levels",
        "landing_levels"
      ],
      "properties": {
        "red": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repair_levels": {
          "type": "array",
          "items": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4"
            ]
          }
        },
        "landing_levels": {
          "type": "array",
          "items": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4"
            ]
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "required": [
        "zero_owned_processes_after_run"
      ],
      "properties": {
        "locked_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_new_test_file_loc": {
          "type": "integer",
          "minimum": 1
        },
        "max_new_production_file_loc": {
          "type": "integer",
          "minimum": 1
        },
        "zero_owned_processes_after_run": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": true
}
