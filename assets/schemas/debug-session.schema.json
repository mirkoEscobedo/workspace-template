{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mirkoEscobedo/workspace-template/schemas/debug-session-v1.json",
  "title": "Bounded native debug session",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runtime", "request"],
  "properties": {
    "version": { "const": 1 },
    "runtime": { "enum": ["rust", "node", "dart", "flutter"] },
    "request": { "enum": ["launch", "attach"] },
    "program": { "type": "string", "minLength": 1 },
    "args": { "type": "array", "items": { "type": "string" }, "maxItems": 128 },
    "cwd": { "type": "string" },
    "pid": { "type": "integer", "minimum": 1 },
    "endpoint": { "type": "string" },
    "breakpoints": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "line"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 256,
      "items": { "enum": ["continue", "pause", "stepOver", "stepIn", "stepOut", "capture"] }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "maxThreads": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxFrames": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxScopes": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxVariables": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maxStringBytes": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "terminateTarget": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "request": { "const": "launch" } } }, "then": { "required": ["program"] } },
    { "if": { "properties": { "request": { "const": "attach" } } }, "then": { "anyOf": [{ "required": ["pid"] }, { "required": ["endpoint"] }] } }
  ]
}
