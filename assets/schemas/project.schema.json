{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mirkoEscobedo/workspace-template/schemas/project-v2.json",
  "title": "Adaptive Delivery thin project state",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workspaceTemplate", "execution", "capabilities", "overrides", "history"],
  "properties": {
    "version": { "const": 2 },
    "workspaceTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "releaseVersion",
        "sourceCommit",
        "releaseCommit",
        "embeddedAssetManifestSha256",
        "releaseManifestSha256",
        "artifacts"
      ],
      "properties": {
        "packageName": { "type": "string", "minLength": 1 },
        "releaseVersion": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "releaseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "embeddedAssetManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "releaseManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["packageName", "rustTarget", "executableSha256", "signingStatus"],
            "properties": {
              "packageName": { "type": "string", "minLength": 1 },
              "rustTarget": { "type": "string", "minLength": 1 },
              "executableSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "signingStatus": { "enum": ["unsigned-development", "authenticode-rfc3161"] }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "defaultMode", "limits"],
      "properties": {
        "method": { "const": "adaptive" },
        "defaultMode": { "const": "direct" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semanticRepairs", "flakyReruns"],
          "properties": {
            "semanticRepairs": { "const": 2 },
            "flakyReruns": { "const": 1 }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime-debug", "interactive-gui"],
      "properties": {
        "runtime-debug": { "enum": ["optional", "required", "unavailable"] },
        "interactive-gui": { "enum": ["optional", "required", "unavailable"] }
      }
    },
    "overrides": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "excludeRoots": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/safeRelativePath" }
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["root", "kind"],
                "properties": {
                  "root": { "$ref": "#/$defs/safeRelativePath" },
                  "id": { "type": "string", "minLength": 1 },
                  "kind": { "enum": ["node", "rust", "dart", "flutter", "unknown"] },
                  "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                }
              }
            },
            "commands": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "$ref": "#/$defs/command" }
              }
            },
            "verificationCoverage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["completeGate", "requirements"],
              "properties": {
                "completeGate": { "type": "boolean" },
                "requirements": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "commands"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                      "commands": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 128,
                        "items": { "$ref": "#/$defs/command" }
                      }
                    }
                  }
                }
              }
            },
            "verificationInputs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "files", "programs"],
              "properties": {
                "version": { "const": 1 },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4096,
                  "items": {
                    "allOf": [{ "$ref": "#/$defs/safeRelativePath" }],
                    "maxLength": 4096
                  }
                },
                "programs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                },
                "environment": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "enum": ["CI", "NODE_ENV", "RUSTFLAGS", "RUSTUP_TOOLCHAIN", "CARGO_BUILD_TARGET", "CARGO_PROFILE", "FLUTTER_BUILD_MODE"]
                  }
                },
                "serviceConstraints": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "revision"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                      "revision": { "type": "string", "minLength": 1, "maxLength": 128 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "migrationIndex": { "type": ["string", "null"] },
        "resumption": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^[A-Za-z]:)|(^[/\\\\])|((^|[/\\\\])\\.\\.([/\\\\]|$))" }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "args", "cwd"],
      "properties": {
        "program": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" }, "maxItems": 128 },
        "cwd": { "$ref": "#/$defs/safeRelativePath" }
      }
    }
  }
}
