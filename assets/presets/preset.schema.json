{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workspace-template:agent-preset:1",
  "title": "workspace-template agent routing preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "description", "stability", "models", "roles"],
  "allOf": [
    {
      "if": { "required": ["fallbacks"] },
      "then": {
        "properties": {
          "models": {
            "required": ["terra-medium", "codex-spark-xhigh"],
            "properties": {
              "terra-medium": {
                "properties": {
                  "reasoningEffort": { "const": "medium" },
                  "targets": {
                    "required": ["codex"],
                    "properties": {
                      "codex": { "const": "gpt-5.6-terra" }
                    }
                  }
                }
              },
              "codex-spark-xhigh": {
                "properties": {
                  "reasoningEffort": { "const": "xhigh" },
                  "targets": {
                    "required": ["codex", "opencode"],
                    "properties": {
                      "codex": { "const": "gpt-5.3-codex-spark" },
                      "opencode": { "const": "openai/gpt-5.3-codex-spark" }
                    }
                  }
                }
              }
            }
          },
          "roles": {
            "properties": {
              "scout": { "const": "codex-spark-xhigh" },
              "implementer": { "const": "codex-spark-xhigh" },
              "reviewer-spec": { "const": "codex-spark-xhigh" },
              "reviewer-code": { "const": "codex-spark-xhigh" },
              "reviewer-ops": { "const": "codex-spark-xhigh" },
              "repairer": { "const": "codex-spark-xhigh" },
              "integrator": { "const": "codex-spark-xhigh" }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1 },
    "stability": { "enum": ["stable", "experimental"] },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reasoningEffort", "targets"],
        "properties": {
          "reasoningEffort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] },
          "targets": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "codex": { "type": "string", "minLength": 1 },
              "opencode": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinator",
        "planner",
        "scout",
        "implementer",
        "reviewer-spec",
        "reviewer-code",
        "reviewer-ops",
        "repairer",
        "integrator"
      ],
      "properties": {
        "coordinator": { "type": "string" },
        "planner": { "type": "string" },
        "scout": { "type": "string" },
        "implementer": { "type": "string" },
        "reviewer-spec": { "type": "string" },
        "reviewer-code": { "type": "string" },
        "reviewer-ops": { "type": "string" },
        "repairer": { "type": "string" },
        "integrator": { "type": "string" }
      }
    },
    "fallbacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codexChildModelRefusal"],
      "properties": {
        "codexChildModelRefusal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roles", "brokerModel", "delegateTarget"],
          "properties": {
            "roles": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "scout",
                  "implementer",
                  "reviewer-spec",
                  "reviewer-code",
                  "reviewer-ops",
                  "repairer",
                  "integrator"
                ]
              }
            },
            "brokerModel": { "const": "terra-medium" },
            "delegateTarget": { "const": "opencode" }
          }
        }
      }
    }
  }
}
