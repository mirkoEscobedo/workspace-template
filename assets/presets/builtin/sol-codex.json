{
  "$schema": "../preset.schema.json",
  "version": 1,
  "id": "sol-codex",
  "description": "Use GPT-5.6 Sol for coordination and planning, with GPT-5.3 Codex natively and GPT-5.3 Codex Spark through OpenCode for delegated engineering roles.",
  "stability": "stable",
  "models": {
    "sol-high": {
      "reasoningEffort": "high",
      "targets": {
        "codex": "gpt-5.6-sol",
        "opencode": "openai/gpt-5.6-sol"
      }
    },
    "codex-high": {
      "reasoningEffort": "high",
      "targets": {
        "codex": "gpt-5.3-codex",
        "opencode": "openai/gpt-5.3-codex-spark"
      }
    }
  },
  "roles": {
    "coordinator": "sol-high",
    "planner": "sol-high",
    "scout": "codex-high",
    "implementer": "codex-high",
    "reviewer-spec": "codex-high",
    "reviewer-code": "codex-high",
    "reviewer-ops": "codex-high",
    "repairer": "codex-high",
    "integrator": "codex-high"
  }
}
