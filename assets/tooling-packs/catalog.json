{
  "version": 1,
  "packs": {
    "quality": {
      "description": "Stack-appropriate formatting, linting, and full verification wiring.",
      "projects": {
        "typescript": {
          "dependencies": [
            {
              "name": "@biomejs/biome",
              "kind": "development"
            }
          ],
          "scripts": {
            "lint": "biome check .",
            "format": "biome format --write ."
          },
          "configs": [
            {
              "path": "biome.json",
              "format": "json",
              "patches": [
                {
                  "path": "/formatter/enabled",
                  "value": true
                },
                {
                  "path": "/linter/enabled",
                  "value": true
                }
              ]
            }
          ]
        },
        "javascript": {
          "dependencies": [
            {
              "name": "@biomejs/biome",
              "kind": "development"
            }
          ],
          "scripts": {
            "lint": "biome check .",
            "format": "biome format --write ."
          },
          "configs": [
            {
              "path": "biome.json",
              "format": "json",
              "patches": [
                {
                  "path": "/formatter/enabled",
                  "value": true
                },
                {
                  "path": "/linter/enabled",
                  "value": true
                }
              ]
            }
          ]
        },
        "react": {
          "dependencies": [
            {
              "name": "@biomejs/biome",
              "kind": "development"
            }
          ],
          "scripts": {
            "lint": "biome check .",
            "format": "biome format --write ."
          },
          "configs": [
            {
              "path": "biome.json",
              "format": "json",
              "patches": [
                {
                  "path": "/formatter/enabled",
                  "value": true
                },
                {
                  "path": "/linter/enabled",
                  "value": true
                }
              ]
            }
          ]
        },
        "rust": {
          "dependencies": [],
          "scripts": {}
        },
        "flutter": {
          "dependencies": [
            {
              "name": "flutter_lints",
              "kind": "development"
            }
          ],
          "scripts": {},
          "configs": [
            {
              "path": "analysis_options.yaml",
              "format": "yaml",
              "patches": [
                {
                  "path": "/include",
                  "value": "package:flutter_lints/flutter.yaml"
                }
              ]
            }
          ]
        }
      }
    },
    "testing": {
      "description": "Stack-appropriate unit-test support.",
      "projects": {
        "typescript": {
          "dependencies": [
            {
              "name": "vitest",
              "kind": "development"
            }
          ],
          "scripts": {
            "test": "vitest run"
          }
        },
        "javascript": {
          "dependencies": [
            {
              "name": "vitest",
              "kind": "development"
            }
          ],
          "scripts": {
            "test": "vitest run"
          }
        },
        "react": {
          "dependencies": [
            {
              "name": "vitest",
              "kind": "development"
            },
            {
              "name": "jsdom",
              "kind": "development"
            },
            {
              "name": "@testing-library/react",
              "kind": "development"
            },
            {
              "name": "@testing-library/jest-dom",
              "kind": "development"
            }
          ],
          "scripts": {
            "test": "vitest run"
          }
        },
        "rust": {
          "dependencies": [],
          "scripts": {}
        },
        "flutter": {
          "dependencies": [],
          "scripts": {}
        }
      }
    },
    "typescript": {
      "description": "TypeScript compiler and type-check command.",
